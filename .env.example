# Strapi backend
NEXT_PUBLIC_STRAPI_URL=https://nxt.bargains
STRAPI_INTERNAL_URL=http://127.0.0.1:8888
STRAPI_API_TOKEN=

# Public site URL (used for canonicals, sitemap, RSS, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://nxtbargains.fxnstudio.com

# Default Amazon Associates tag — appended to amzn.to / amazon.* links missing a tag
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=

# RapidAPI coupon feeds (server-side only)
RAPIDAPI_KEY=
# Legacy RapidAPI coupon feed (get-promo-codes). Being replaced by Feedico.
# Set COUPONS_API_PAUSED=true to stop live RapidAPI coupon calls (serve cache only).
COUPONS_API_PAUSED=true
RAPIDAPI_PROMO_CODES_HOST=get-promo-codes.p.rapidapi.com
RAPIDAPI_PROMO_CODES_PATH=/data/get-coupons/?page=1&sort=update_time_desc
RAPIDAPI_PROMO_STORES_PATH=/data/get-stores/?page=1
RAPIDAPI_POPULAR_COUPON_BRANDS=amazon,ebay,walmart,newegg

# Feedico (https://feedico.io) — affiliate-network coupon aggregator → Strapi nxt-coupons.
# Start on the free tier (1 network). Amazon stays on Amazon Associates.
#   node scripts/sync-feedico-coupons.mjs --dry   (inspect mapping first)
FEEDICO_API_TOKEN=
FEEDICO_BASE_URL=https://api.feedico.io
FEEDICO_COUPONS_PATH=/api/v1/me/coupons
FEEDICO_NETWORK=

# CouponAPI.org — paid affiliate-coupon feed (alternative to Feedico).
#   node scripts/fetch-couponapi.mjs --dry
COUPONAPI_KEY=
COUPONAPI_BASE_URL=https://couponapi.org/api
COUPONAPI_MERCHANTS=ebay,amazon,walmart,target,bestbuy,newegg

# Which local coupon-feed cache the site reads:
#   couponapi = only data/coupons-couponapi.json (Feedico OFF)
#   feedico   = only data/coupons-feedico.json
#   (unset)   = CouponAPI.org preferred, Feedico as fallback
COUPON_FEED_SOURCE=
RAPIDAPI_AMAZON_DEALS_HOST=amazon-promo-codes-and-deals.p.rapidapi.com
RAPIDAPI_AMAZON_DEALS_KEY=
RAPIDAPI_AMAZON_DEALS_PATH=/deals.php?limit=20&offset=0&min_discount=50&max_discount=90&channel=1&category=Apparel&merchant=Amazon&condition=New&coupon_only=1&promo_only=1&since=2026-03-26&dual_offer=1

# Private research access for /coupons/stores
COUPON_STORES_ADMIN_TOKEN=

# Takeads (https://takeads.com) — long-tail link converter. Monetizes outbound
# URLs that no other network covers. scripts/fetch-takeads-links.mjs builds
# data/takeads-links.json ahead of the build; nothing calls the API at render.
TAKEADS_PUBLIC_KEY=
TAKEADS_SUB_ID=

# Google Analytics 4 measurement id. Loaded only after analytics consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Signs the /go/<token> outbound redirect links. Any long random string, e.g.
# `openssl rand -base64 32`. The signature is what stops /go being an open
# redirect, so this must be set in production and must not be shared publicly.
# Leave it empty and affiliate links simply go direct: no tracking, nothing
# broken.
CLICK_TRACKING_SECRET=

# Identifies this site when recording a click. Must match the `slug` of the
# site's row in the CMS registry (Commerce · Site).
NEXT_PUBLIC_SITE_SLUG=nxt-bargains
# Product catalogue source. Keep `strapi` until the Supabase schema and data
# migration have been validated, then switch this to `supabase`.
COMMERCE_DATA_SOURCE=strapi
SUPABASE_URL=
SUPABASE_ANON_KEY=
# GENIUSLINK INTEGRATION
GENIUSLINK_TSID=441460
NEXT_PUBLIC_GENIUSLINK_TSID=441460
GENIUSLINK_API_KEY=
GENIUSLINK_API_SECRET=
GENIUSLINK_GROUP_ID=441460
GENIUSLINK_CUSTOM_DOMAIN=geni.us
